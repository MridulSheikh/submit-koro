enum OverviewPermission {
  NO_ACCESS
  VIEW
}

enum ReviewPermission {
  NO_ACCESS
  VIEW
  REVIEW
}

enum SubmissionPermission {
  NO_ACCESS
  VIEW
  SUBMIT
}

enum TeamPermission {
  NO_ACCESS
  VIEW
  MANAGE
}

model Role {
  id                   String               @id @default(uuid())
  name                 String               @unique
  key                  String               @unique
  overviewPermission   OverviewPermission[]   @default([])
  reviewPermission     ReviewPermission[]     @default([])
  submissionPermission SubmissionPermission[] @default([])
  teamPermission       TeamPermission[]       @default([])
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  users                User[]

  @@index([key, id])
  @@map("roles")
}
