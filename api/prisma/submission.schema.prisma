enum SubmissionStatus {
  PENDING
  IN_REVIEW
  REVIEWED
  APPROVED
  REJECTED
}

model Submission {
  id            String           @id @default(uuid())
  projectName   String
  description   String?
  liveUrl       String
  repositoryUrl String
  status        SubmissionStatus @default(PENDING)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews Review[]

  @@unique([userId, projectName, liveUrl, repositoryUrl])
  @@index([userId])
  @@index([status])
  @@index([projectName])
  @@map("submissions")
}
